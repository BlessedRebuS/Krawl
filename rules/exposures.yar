// most specific request indicator of one check: a path, a static parameter or
// a vendor header that no other check and no benign request uses. Rules are
// confidence = "medium": a probe for the endpoint is a strong signal, but a
// rule cannot tell an exploit attempt from a scanner fingerprinting it.
// The `reference` field links the source check.

rule krawl_probe_exposed_backups {
    meta:
        attack_type = "backup_file_probe"
        classification = "attack"
        severity = 5
        confidence = "medium"
        description = "Request for a backup, archive or dump file left in the web root, from the nuclei exposure checks."
        mitre_attack = "T1595.002, T1083"
        version = "1.0"
        date = "2026-10-27"
        modified = "2026-10-27"
        author = "Krawl (indicators from nuclei-templates)"
        false_positives = "Sites that really publish one of these files; none on a honeypot."
        reference = "https://github.com/projectdiscovery/nuclei-templates/blob/main/http/exposures/backups"
        response_type = "sensitive_file"
    strings:
        $p0 = "/inc/mysql_backup/" ascii nocase
        $p1 = "/install/froxlor.sql" ascii nocase
        $p2 = "/mysql.initial.sql" ascii nocase
    condition:
        scan_target == "path" and any of them
}

