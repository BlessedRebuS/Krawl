<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <display-name>customer-portal</display-name>
  <context-param>
    <param-name>jdbc.url</param-name>
    <param-value>jdbc:postgresql://pg.internal:5432/erp</param-value>
  </context-param>
  <context-param>
    <param-name>jdbc.driver</param-name>
    <param-value>org.postgresql.Driver</param-value>
  </context-param>
  <context-param>
    <param-name>jdbc.username</param-name>
    <param-value>erp</param-value>
  </context-param>
  <context-param>
    <param-name>jdbc.password</param-name>
    <param-value>Bl4ckP3pper#</param-value>
  </context-param>
  <servlet>
    <servlet-name>dispatcher</servlet-name>
    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>dispatcher</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>AdminConsole</servlet-name>
    <servlet-class>com.globex.admin.ConsoleServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminConsole</servlet-name>
    <url-pattern>/internal/admin/*</url-pattern>
  </servlet-mapping>
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>admin</web-resource-name>
      <url-pattern>/internal/admin/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>manager</role-name>
    </auth-constraint>
  </security-constraint>
  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>
</web-app>
